# Copy this file to .env, set unique strong passwords, and provide TLS files in mosquitto/certs/.
APP_PORT=4477
DB_ROOT_PASS=change-this-to-a-different-strong-password
DB_USER=soundair_app
DB_PASS=change-this-to-a-strong-password
DB_NAME=gas_sound_db
DB_TABLE=sensor_gas_sound

# MQTT broker configuration
# These values are used by the app on Docker's private network.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=change-this-username
MQTT_PASS=change-this-to-another-strong-password
MQTT_TOPIC=sensors/data/lora
MQTT_TOPICS=sensors/data/lora,sensors/data/wifi,sensors/data/lora/raw,sensor/gateway/status

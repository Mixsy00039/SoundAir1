# Copy this file to .env and replace the placeholders before starting Docker.
DB_PASS=change-this-to-a-strong-password
DB_NAME=gas_sound_db
DB_TABLE=sensor_gas_sound

# MQTT broker configuration
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=change-this-username
MQTT_PASS=change-this-to-a-strong-password
MQTT_TOPIC=sensors/data/lora
MQTT_TOPICS=sensors/data/lora,sensors/data/wifi,sensors/data/lora/raw,sensor/gateway/status
